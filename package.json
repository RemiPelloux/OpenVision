{
  "name": "openvision",
  "version": "0.2.0-preview.2",
  "private": true,
  "type": "module",
  "description": "Experimental AI coding workspace customization with local profiles, custom providers, agents, Tab autocomplete and MCP.",
  "repository": { "type": "git", "url": "https://github.com/RemiPelloux/OpenVision.git" },
  "homepage": "https://github.com/RemiPelloux/OpenVision#readme",
  "bugs": { "url": "https://github.com/RemiPelloux/OpenVision/issues" },
  "keywords": ["openvision", "ai-coding", "ide", "code-editor", "ai-agents", "autocomplete", "mcp", "custom-ai-provider", "developer-tools"],
  "scripts": {
    "start": "node desktop/start.mjs",
    "package:windows": "node desktop/package-windows.mjs",
    "test:installer": "node --test desktop/portable-installer.test.mjs",
    "build:desktop": "node desktop/build-source.mjs",
    "prepare:desktop": "node desktop/prepare-source.mjs",
    "import:cursor": "node desktop/import-cli.mjs",
    "import:settings": "node desktop/import-cli.mjs",
    "check:desktop": "node desktop/check.mjs",
    "test:portable": "node --test desktop/platform.test.mjs desktop/native-identity.test.mjs desktop/native-assets.test.mjs desktop/source-assembly.test.mjs desktop/cursor-import.test.mjs desktop/branding.test.mjs",
    "test:desktop": "node --test desktop/local-workbench.test.mjs desktop/model-providers.test.mjs desktop/model-identity.test.mjs desktop/model-selection-customization.test.mjs desktop/model-picker.test.mjs desktop/model-picker-layout.test.mjs desktop/model-picker-pagination.test.mjs desktop/reasoning-transport.test.mjs desktop/reasoning-selection-customization.test.mjs desktop/build-cache.test.mjs desktop/import-preview.test.mjs desktop/extension-integrity.test.mjs desktop/agent-runtime.test.mjs desktop/context-customization.test.mjs desktop/stream-customization.test.mjs desktop/import-replacement.test.mjs desktop/local-rules.test.mjs desktop/rules-durable.test.mjs desktop/subagent-model-customization.test.mjs desktop/completion-cancellation.test.mjs desktop/local-chat-title.test.mjs desktop/model-performance.test.mjs desktop/context-work.test.mjs desktop/memory-customization.test.mjs desktop/workspace-memory.test.mjs desktop/legacy-memory-customization.test.mjs",
    "verify:desktop": "node desktop/verify.mjs",
    "verify:welcome": "node desktop/verify-welcome.mjs",
    "test:welcome": "node --test desktop/welcome-customization.test.mjs",
    "test:paste": "node --test desktop/large-paste.test.mjs desktop/paste-customization.test.mjs",
    "test:namespace": "node --test desktop/project-namespace.test.mjs desktop/project-namespace-migration.test.mjs desktop/namespace-plans.test.mjs",
    "migrate:project": "node desktop/migrate-project.mjs",
    "verify:paste": "node desktop/verify-paste.mjs",
    "verify:local-rules": "node desktop/verify-local-rules.mjs",
    "verify:rules:windows": "node desktop/verify-rules-windows.mjs",
    "control-plane": "node src/server.mjs",
    "check": "node --check src/config.mjs && node --check src/mcp.mjs && node --check src/rea.mjs && node --check src/server.mjs",
    "test:mcp": "node --test test/mcp.mjs",
    "test:telemetry": "node --test desktop/telemetry-core.test.mjs desktop/telemetry-extensions.test.mjs desktop/telemetry-workbench.test.mjs",
    "verify:telemetry": "node desktop/verify-telemetry.mjs",
    "test:completion": "node --test desktop/completion-provider.test.mjs desktop/completion-response.test.mjs desktop/completion-keyboard.test.mjs desktop/completion-undo.test.mjs desktop/profile-paths.test.mjs desktop/subagent-paths.test.mjs",
    "verify:completion": "node desktop/verify-completion.mjs",
    "status:features": "node desktop/feature-status.mjs",
    "test:feature-status": "node --test desktop/feature-status.test.mjs",
    "test:agent-process": "node --test desktop/agent-process.test.mjs",
    "test:context-work": "node --test desktop/context-customization.test.mjs desktop/context-work.test.mjs",
    "test:provider-probe": "node --test desktop/live-provider-probe.test.mjs desktop/live-payload-probe.test.mjs desktop/live-completion-probe.test.mjs",
    "verify:providers:live": "node desktop/verify-live-providers.mjs",
    "verify:agent:live": "node desktop/verify-live-agent.mjs",
    "test:agent-relay": "node --test desktop/live-agent-relay.test.mjs",
    "test:provider-errors": "node --test desktop/provider-error-policy.test.mjs desktop/provider-error-body.test.mjs desktop/provider-error-ui.test.mjs desktop/live-provider-probe.test.mjs",
    "verify:provider-errors": "node desktop/verify-provider-errors.mjs",
    "verify:project": "node desktop/verify-project.mjs",
    "verify:agent": "node desktop/verify-agent.mjs",
    "benchmark:native": "node desktop/verify-agent.mjs --baseline",
    "test:native-baseline": "node --test desktop/native-baseline.test.mjs",
    "test:mcp-lazy": "node --test desktop/mcp-lazy.test.mjs desktop/mcp-routing.test.mjs desktop/mcp-attempt.test.mjs desktop/mcp-cancel.test.mjs desktop/mcp-reconnect.test.mjs desktop/mcp-lifecycle-cleanup.test.mjs",
    "smoke": "node test/smoke.mjs",
    "benchmark:models": "node --expose-gc desktop/benchmark-models.mjs",
    "benchmark:context": "node --expose-gc desktop/benchmark-context.mjs",
    "verify:model-menu": "node desktop/verify-model-menu.mjs",
    "verify:model-menu:large": "node desktop/verify-large-model-menu.mjs",
    "verify:catalog-retention": "node desktop/verify-catalog-retention.mjs",
    "verify:provider-identity": "node desktop/verify-provider-identity.mjs",
    "verify:reasoning-capabilities": "node desktop/verify-reasoning-capabilities.mjs",
    "verify:subagent-reasoning": "node desktop/verify-subagent-reasoning.mjs",
    "test:memory": "node --test desktop/memory-customization.test.mjs desktop/workspace-memory.test.mjs desktop/legacy-memory-customization.test.mjs",
    "verify:memory": "node desktop/verify-memory.mjs",
    "verify:mcp-cleanup": "node desktop/verify-mcp-cleanup.mjs",
    "verify:legacy-memory": "node desktop/verify-legacy-memory.mjs",
    "verify:legacy-memory:stale": "node desktop/verify-legacy-memory.mjs --stale",
    "verify:project:lifecycle": "node desktop/verify-project-lifecycle.mjs",
    "verify:language": "node desktop/verify-language.mjs",
    "test:save-all": "node --test desktop/save-all.test.mjs",
    "verify:save-all": "node desktop/save-all-verify.mjs",
    "verify:memory:filesystem": "node desktop/verify-memory.mjs --filesystem",
    "setup:cpp": "node desktop/setup-cpp.mjs",
    "verify:cpp": "node desktop/verify-cpp.mjs",
    "test:git-worktrees": "node --test desktop/git-worktree.test.mjs",
    "verify:git": "node desktop/verify-git.mjs",
    "verify:development": "node desktop/verify-development.mjs",
    "test:shutdown": "node --test desktop/shutdown.test.mjs"
  },
  "engines": {
    "node": ">=24.18.0"
  }
}
